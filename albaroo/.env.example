# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for: Admin creating auth accounts
# (Section 2), the nightly photo-retention Storage job, and the RLS test suite setup.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when it invokes
# /api/cron/retention. Vercel sets this header automatically once CRON_SECRET is
# defined as an env var on the project — generate any long random string.
CRON_SECRET=

# Only needed to run `npm run test:rls` locally against a real project.
SUPABASE_ANON_KEY=
