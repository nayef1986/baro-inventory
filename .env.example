# SWEET COST — قاعدة بيانات Supabase
# انسخ هذا الملف إلى .env.local وضع قيمك الحقيقية.
VITE_SWEETCOST_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SWEETCOST_SUPABASE_ANON_KEY=eyJhbGciOi...

# بوابة الدخول. مطفأة بطلب صاحب المتجر — التطبيق يفتح مباشرة.
# لتفعيلها: أنشئ مستخدماً في لوحة Supabase، اجعل القيمة true،
# ثم شغّل supabase/migrations/0005_require_auth.sql.
VITE_SWEETCOST_REQUIRE_AUTH=false
